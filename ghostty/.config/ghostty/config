background-opacity = 1
custom-shader = shaders/cursor_sweep.glsl
custom-shader = shaders/ripple_cursor.glsl
custom-shader-animation = always
font-size = 11
theme = Zenbones Dark 
cursor-style = block
macos-titlebar-style=hidden
shell-integration-features = no-cursor,sudo,no-title
window-colorspace = "display-p3"
mouse-hide-while-typing = true
window-padding-x = 20
confirm-close-surface = false
window-padding-y = 20
palette = 8=#899499
copy-on-select = clipboard
keybind = shift+f>r=reload_config
keybind = shift+f>n=new_window
keybind = shift+f>x=close_surface
keybind= shift+f>f=toggle_quick_terminal
