
set -g default-terminal "screen-256color"
set -ag terminal-overrides ",xterm-256color:RGB"

set -g prefix C-a
unbind C-b
bind-key C-a send-prefix

unbind %
bind | split-window -h

unbind '"'
bind - split-window -v

unbind r
bind r source-file ~/.tmux.conf

bind -r j resize-pane -D 5
bind -r k resize-pane -U 5
bind -r l resize-pane -R 5
bind -r h resize-pane -L 5

bind -n C-k clear-history

bind -n C-s display-popup -E "\
    tmux list-sessions -F '#{?session_attached,,#{session_name}}' |\
    sed '/^$/d' |\
    fzf --reverse --header jump-to-session --preview 'tmux capture-pane -pt {}'  |\
    xargs tmux switch-client -t"
bind -r m resize-pane -Z

set -g mouse on

set -g focus-events on
set -g status-style bg=default
set -g status-left-length 99
set -g status-right-length 99
set -g status-justify centre

set-window-option -g mode-keys vi

bind-key -T copy-mode-vi 'v' send -X begin-selection # start selecting text with "v"
bind-key -T copy-mode-vi 'y' send -X copy-selection # copy text with "y"

unbind -T copy-mode-vi MouseDragEnd1Pane # don't exit copy mode after dragging with mouse

set -g mode-style "fg=#1F1F28,bg=#DCD7BA"
 set -g message-style "fg=#1F1F28,bg=#DCD7BA"
 set -g message-command-style "fg=#1F1F28,bg=#DCD7BA"
 set -g pane-border-style "fg=#957FB8"
 set -g pane-active-border-style "fg=#957FB8"
 set -g status "on"
 set -g status-justify "left"
 set -g status-style "fg=#957FB8,bg=#0D0C0C"
 set -g status-left-length "100"
 set -g status-right-length "100"
 set -g status-left-style NONE
 set -g status-right-style NONE
 set -g status-left "#[fg=#0D0C0C,bg=#957FB8,bold] #S #[fg=#957FB8,bg=#0D0C0C,nobold,nounderscore,noitalics]"
 set -g status-right "#[fg=#0D0C0C,bg=#0D0C0C,nobold,nounderscore,noitalics]#[fg=#957FB8,bg=#0D0C0C]#{prefix_highlight} #[fg=#957FB8,bg=#0D0C0C,nobold,nounderscore,noitalics]#[fg=#1F1F28,bg=#DCD7BA] %Y-%m-%d | %I:%M %p #[fg=#DCD7BA,bg=#957FB8,nobold,nounderscore,noitalics]#[fg=#0D0C0C,bg=#957FB8,bold] #h "
 setw -g window-status-activity-style "underscore,fg=#957FB8,bg=#ff0000"
 setw -g window-status-separator ""
 setw -g window-status-style "NONE,fg=#957FB8,bg=#0D0C0C"
 setw -g window-status-format "#[fg=#0D0C0C,bg=#0D0C0C,nobold,nounderscore,noitalics]#[default] #I | #W #F #[fg=#0D0C0C,bg=#0D0C0C,nobold,nounderscore,noitalics]"
 setw -g window-status-current-format "#[fg=#0D0C0C,bg=#DCD7BA,nobold,nounderscore,noitalics]#[fg=#1F1F28,bg=#DCD7BA,bold] #I | #W #F #[fg=#DCD7BA,bg=#0D0C0C,nobold,nounderscore,noitalics]"


set -g @plugin 'tmux-plugins/tmux-resurrect' # persist tmux sessions after computer restart
set -g @plugin 'tmux-plugins/tmux-continuum' # automatically saves sessions for you every 15 minutes
# set -g @resurrect-capture-pane-contents 'on' # allow tmux-ressurect to capture pane contents
set -g @resurrect-capture-pane-contents 'off' # allow tmux-ressurect to capture pane contents
set -g @continuum-restore 'on'

set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'omerxx/tmux-sessionx'
set -g @sessionx-bind 'v'

run '~/.tmux/plugins/tpm/tpm'
